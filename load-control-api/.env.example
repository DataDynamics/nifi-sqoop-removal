# API 런타임 계정(DDL 권한 없음)
LCA_DATABASE_URL=postgresql+asyncpg://load_control_api:CHANGE_ME@meta:5432/nifiops
# migration 전용 계정(alembic upgrade head)
LCA_MIGRATION_DATABASE_URL=postgresql+asyncpg://nifi_ops_migrator:CHANGE_ME@meta:5432/nifiops
# role별 Bearer 토큰 SHA-256 digest. 생성: python -m load_control.security <token>
LCA_TOKEN_DIGESTS={"nifi":["<sha256-hex>"],"operator":["<sha256-hex>"]}
LCA_DB_POOL_SIZE=10
LCA_DB_MAX_OVERFLOW=5
LCA_LOG_LEVEL=INFO
LCA_LOG_JSON=true

# worker 프로세스(dispatcher, sweeper) 전용 — 다음 단계에서 구현
# LCA_LISTEN_DSN=postgresql://load_control_api:CHANGE_ME@meta:5432/nifiops
# LCA_NIFI_RECEIVER_URL=https://nifi-lb.internal:9443
# LCA_RUN_TIMEOUT=PT6H
# LCA_RECOVERY_STALE=PT90M
# LCA_EXTRACT_QUERY_TIMEOUT=PT60M
# LCA_RECOVERY_MODE=FAIL
