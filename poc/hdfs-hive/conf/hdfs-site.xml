<?xml version="1.0"?>
<!-- 단일 DataNode PoC. libvirt 내부망(192.168.122.1)에만 연다. -->
<configuration>
  <property><name>dfs.replication</name><value>1</value></property>
  <!-- NiFi(nifi)가 쓴 파일을 HiveServer2(hive)가 읽는다. 운영도 권한 검사를 하지 않는다 -->
  <property><name>dfs.permissions.enabled</name><value>false</value></property>
  <property><name>dfs.namenode.rpc-address</name><value>192.168.122.1:8020</value></property>
  <property><name>dfs.namenode.http-address</name><value>192.168.122.1:9870</value></property>
  <property><name>dfs.namenode.name.dir</name><value>/hadoop/dfs/name</value></property>
  <property><name>dfs.datanode.data.dir</name><value>/hadoop/dfs/data</value></property>
  <property><name>dfs.datanode.address</name><value>192.168.122.1:9866</value></property>
  <property><name>dfs.datanode.http.address</name><value>192.168.122.1:9864</value></property>
  <property><name>dfs.datanode.ipc.address</name><value>192.168.122.1:9867</value></property>
</configuration>
